{
  "executionEnvironments": [
    {
      "id": "10000000-0000-4000-8000-000000000001",
      "kind": "outbound",
      "label": "OpenCode Linux host",
      "workspaceRoots": [
        "/srv/workspaces"
      ],
      "operations": {
        "kind": "sidecar",
        "enabledCapabilities": [
          "directory_browser",
          "workspace_files",
          "workspace_tools",
          "workspace_context",
          "workspace_skills",
          "composer_attachments",
          "agent_tools_cli"
        ]
      },
      "platform": "linux",
      "pairingId": "20000000-0000-4000-8000-000000000001"
    }
  ],
  "backends": [
    {
      "id": "opencode-v2",
      "kind": "opencode",
      "label": "OpenCode v2",
      "enabled": true,
      "modelPolicy": {
        "type": "catalog"
      },
      "moduleConfiguration": {
        "nativeStorePath": "/home/agent/.local/share/opencode/opencode.db",
        "configDirectory": "/home/agent/.config/opencode",
        "connection": {
          "ownership": "owned",
          "channel": {
            "type": "process_stdio",
            "executablePath": "/home/agent/.local/bin/opencode2",
            "workingDirectory": "/srv/workspaces"
          }
        }
      }
    }
  ],
  "targets": [
    {
      "id": "opencode-target",
      "kind": "opencode_http",
      "label": "OpenCode",
      "backendInstanceId": "opencode-v2",
      "executionEnvironmentId": "10000000-0000-4000-8000-000000000001",
      "enabled": true,
      "moduleConfiguration": {
        "defaults": {
          "model": {
            "type": "catalogDefault"
          },
          "variant": {
            "type": "modelDefault"
          }
        }
      }
    }
  ],
  "defaultTargetId": "opencode-target",
  "webSearch": null
}
