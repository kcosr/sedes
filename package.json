{
  "name": "sedes",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted workspace for coding agents.",
  "homepage": "https://github.com/kcosr/sedes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcosr/sedes.git"
  },
  "bugs": {
    "url": "https://github.com/kcosr/sedes/issues"
  },
  "type": "module",
  "bin": {
    "sedes": "dist/cli/sedes-cli-main.js",
    "sedes-automation": "dist/cli/automation-cli.js"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "configuration:import": "tsx scripts/configuration/import.ts",
    "postinstall": "node scripts/prepare-node-pty.mjs && node scripts/prune-claude-executables.mjs",
    "predev": "npm run build:pi-sandbox-worker && npm run build:claude-runtime-worker",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node scripts/start-dev-server.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "pretypecheck": "npm run check:docs && npm run check:agent-tool-contracts && npm run check:e2e-timing-baseline && npm run check:server-runtime",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:windows-runtime": "node scripts/test-windows-runtime.mjs",
    "check:docs": "node scripts/check-documentation.mjs",
    "check:agent-tool-contracts": "tsx src/server/agent-tools/schema/check-agent-tool-artifacts.ts",
    "check:e2e-timing-baseline": "node scripts/check-e2e-timing-baseline.mjs",
    "update:e2e-timing-baseline": "node scripts/update-e2e-timing-baseline.mjs",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "generate:third-party-notices": "node scripts/generate-third-party-notices.mjs",
    "check:version": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "test:release": "vitest run tests/unit/release.test.mjs",
    "check:third-party-notices": "node scripts/generate-third-party-notices.mjs --check",
    "generate:codex-protocol": "node scripts/generate-codex-protocol.mjs",
    "check:codex-protocol": "node scripts/generate-codex-protocol.mjs --check",
    "check:codex-generated-runtime": "node scripts/provider-protocol/check-codex-generated-runtime.mjs",
    "generate:acp-protocol": "node scripts/provider-protocol/generate-acp-v1-bindings.mjs",
    "check:acp-protocol": "node scripts/provider-protocol/generate-acp-v1-bindings.mjs --check",
    "capture:grok-o0": "node scripts/grok-probes/capture-grok-o0.mjs",
    "extract:grok-source-routes": "node scripts/grok-probes/extract-grok-source-routes.mjs",
    "check:grok-source-routes": "node scripts/grok-probes/extract-grok-source-routes.mjs --check",
    "check:grok-profile": "node scripts/grok-probes/check-grok-profile.mjs",
    "probe:grok-offline": "tsx scripts/grok-probes/run-grok-offline-tranche.ts",
    "probe:grok-live-readonly": "tsx scripts/grok-probes/run-grok-live-readonly-gate.ts",
    "verify:codex-interactions": "tsx scripts/codex-probes/verify-runtime-interactions.ts",
    "verify:codex-runtime": "tsx scripts/codex-probes/verify-runtime-compatibility.ts",
    "probe:codex-release": "node scripts/codex-probes/probe-release.mjs",
    "probe:codex-d1": "node scripts/codex-probes/probe-d1-empty-thread.mjs",
    "probe:codex-d2a": "node scripts/codex-probes/probe-d2a-mcp-isolation.mjs",
    "install:server": "node scripts/install-server.mjs",
    "uninstall:server": "node scripts/install-server.mjs --uninstall",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:serial": "node scripts/run-e2e.mjs --lanes=1",
    "test:e2e:prebuilt": "node scripts/run-e2e.mjs --prebuilt --lanes=1",
    "test:e2e:parallel:prebuilt": "node scripts/run-e2e.mjs --prebuilt",
    "test:smoke-live-streaming": "node scripts/smoke-live-streaming.mjs",
    "measure:browser": "node scripts/measure-browser.mjs",
    "measure:thread": "node scripts/measure-thread-load.mjs",
    "measure:catchup": "tsx scripts/performance/thread-catchup.ts",
    "automation": "tsx src/cli/automation-cli.ts",
    "test:real-pi": "vitest run --config vitest.real-pi.config.ts",
    "pretest:real-pi-cli": "npm run build",
    "test:real-pi-cli": "vitest run --config vitest.real-pi-cli.config.ts",
    "test:real-codex": "vitest run --no-file-parallelism tests/integration/codex-daemon-supervisor-live.test.ts tests/integration/codex-tui-remote-live.test.ts tests/integration/codex-persistent-runtime-live.test.ts",
    "test:real-claude": "vitest run --config vitest.real-claude.config.ts",
    "test:real-grok": "vitest run --config vitest.real-grok.config.ts",
    "pretest:real-codex-agent-tools": "npm run build",
    "test:real-codex-agent-tools": "vitest run --config vitest.real-codex-agent-tools.config.ts",
    "test:real-codex-ssh-uds": "vitest run tests/integration/codex-ssh-uds-live.test.ts",
    "test:real-codex-tui": "vitest run tests/integration/codex-tui-remote-live.test.ts",
    "pretest:c5c-production-lifecycle": "npm run build",
    "test:c5c-production-lifecycle": "node scripts/check-codex-c5c-production-lifecycle.mjs",
    "test:c3-create": "vitest run tests/unit/codex-release-guard.test.ts tests/unit/codex-conversation-driver.test.ts tests/unit/codex-daemon-supervisor.test.ts tests/integration/conversation-lifecycle-service.test.ts tests/integration/codex-backend-thread-persistence-adapter.test.ts tests/integration/codex-application-integration.test.ts tests/integration/codex-daemon-supervisor-live.test.ts",
    "prebuild": "npm run check:docs && npm run check:agent-tool-contracts && npm run check:pi-sandbox-worker-build-repeatability && npm run check:claude-runtime-worker-build-repeatability",
    "build": "node scripts/clean-build.mjs && vite build && tsc -p tsconfig.server.json && node scripts/build-sidecar.mjs && node scripts/build-outbound-connector.mjs && node scripts/build-pi-sandbox-worker.mjs && node scripts/build-claude-runtime-worker.mjs && node scripts/mark-cli-executable.mjs && npm run check:codex-generated-runtime",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:connector": "node scripts/build-outbound-connector.mjs",
    "check:sidecar-build-repeatability": "node scripts/check-sidecar-build-repeatability.mjs",
    "build:pi-sandbox-worker": "node scripts/build-pi-sandbox-worker.mjs",
    "check:pi-sandbox-worker-build-repeatability": "node scripts/check-pi-sandbox-worker-build-repeatability.mjs",
    "build:claude-runtime-worker": "node scripts/build-claude-runtime-worker.mjs",
    "check:claude-runtime-worker-build-repeatability": "node scripts/check-claude-runtime-worker-build-repeatability.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:verify": "npm run android:sync && node scripts/verify-android-package.mjs --synced && cd android && ./gradlew :app:testDebugUnitTest :app:assembleDebugAndroidTest :app:assembleDebug && cd .. && node scripts/verify-android-package.mjs --assembled",
    "android:install:debug": "npm run android:sync && cd android && ./gradlew installDebug",
    "android:open": "npm run android:sync && cap open android",
    "android:run": "npm run android:sync && cap run android",
    "electron:prepare-local-server": "node scripts/prepare-electron-local-server.mjs",
    "electron:sync": "node scripts/electron-distribution.mjs sync",
    "electron:run": "npm run electron:sync && cap run @capawesome/capacitor-electron",
    "electron:open": "npm run electron:sync && cap open @capawesome/capacitor-electron",
    "electron:build": "node scripts/electron-distribution.mjs package --profile full",
    "electron:smoke": "npm run electron:sync && npm run electron:smoke:prepared",
    "electron:smoke:prepared": "npm --prefix electron run build && node scripts/run-electron-smoke.mjs",
    "electron:smoke:packaged": "node scripts/run-electron-smoke.mjs --packaged",
    "electron:verify": "node scripts/electron-distribution.mjs verify",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "check:server-runtime": "node scripts/check-server-runtime.mjs",
    "package:server": "node scripts/package-server.mjs",
    "verify:server-package": "node scripts/verify-server-package.mjs",
    "electron:package": "node scripts/electron-distribution.mjs package",
    "electron:clean": "node scripts/electron-distribution.mjs clean"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.274",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.4.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capawesome/capacitor-electron": "0.1.0",
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.4.0",
    "@pierre/diffs": "1.3.4",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@sedes/electron-client-credentials": "file:packages/electron-client-credentials",
    "@sedes/electron-connection-runtime": "file:packages/electron-connection-runtime",
    "@sedes/electron-workspace-file-download": "file:packages/electron-workspace-file-download",
    "@shikijs/langs": "4.4.2",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "5.6.0",
    "diff": "9.0.0",
    "express": "5.2.1",
    "ghostty-web": "0.4.0",
    "lucide-react": "1.27.0",
    "mermaid": "11.16.1",
    "micromark-util-decode-string": "2.0.1",
    "node-pty": "1.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "typebox": "1.3.7",
    "ws": "8.21.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.0",
    "@capacitor/cli": "8.4.0",
    "@openai/codex": "0.153.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "acorn": "8.15.0",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1",
    "node-gyp": "12.3.0",
    "selfsigned": "5.5.0",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true,
    "better-sqlite3@13.0.2": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
