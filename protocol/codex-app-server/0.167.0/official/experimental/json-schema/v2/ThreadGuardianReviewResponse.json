{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "GuardianAssessmentOutcome": {
      "description": "Final allow/deny outcome returned by the guardian reviewer.",
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "GuardianRiskLevel": {
      "description": "[UNSTABLE] Risk level assigned by approval auto-review.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "GuardianUserAuthorization": {
      "description": "[UNSTABLE] Authorization level assigned by approval auto-review.",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "ThreadGuardianAssessment": {
      "properties": {
        "outcome": {
          "$ref": "#/definitions/GuardianAssessmentOutcome"
        },
        "rationale": {
          "type": "string"
        },
        "riskLevel": {
          "$ref": "#/definitions/GuardianRiskLevel"
        },
        "userAuthorization": {
          "$ref": "#/definitions/GuardianUserAuthorization"
        }
      },
      "required": [
        "outcome",
        "rationale",
        "riskLevel",
        "userAuthorization"
      ],
      "type": "object"
    }
  },
  "properties": {
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadGuardianAssessment"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null when exec policy skips approval."
    },
    "callId": {
      "type": "string"
    }
  },
  "required": [
    "callId"
  ],
  "title": "ThreadGuardianReviewResponse",
  "type": "object"
}